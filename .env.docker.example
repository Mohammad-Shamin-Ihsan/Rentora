# Copy to `.env` (same directory as docker-compose.yml) and adjust as needed.
# docker compose reads `.env` automatically. All values have working defaults,
# so an empty/absent .env still runs — override only what you need.

# --- Database ---
DB_NAME=rentora
DB_USER=postgres
DB_PASSWORD=postgres

# --- Auth ---
# Generate a real one:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=dev-insecure-change-me
JWT_EXPIRE_MINUTES=1440

# --- Host ports (left side of the mapping) ---
FRONTEND_PORT=8080
BACKEND_PORT=8000

# --- CORS ---
# Must match the URL you actually open the app on.
FRONTEND_URL=http://localhost:8080
